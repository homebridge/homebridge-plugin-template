    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "jest",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@jest/globals": "^29.7.0",
    "@types/bonjour": "^3.5.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/xml2js": "^0.4.9",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "homebridge": "^2.0.0-beta.0",
    "jest": "^29.7.0",
    "knip": "^5.50.5",
    "lint-staged": "^15.2.11",
    "nodemon": "^3.1.9",
    "prettier": "3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.12.2"
  },
  "dependencies": {
    "axios": "^0.26.1",
    "bonjour": "^3.5.0",
    "eslint-plugin-jest": "^28.11.0",
    "homebridge-base-platform": "^1.4.2",
    "homebridge-lib": "^7.1.0",
    "xml2js": "^0.4.23"
  }
