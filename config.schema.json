{
  "pluginAlias": "SoundTouchHomebridgePlugin",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "discoverAllAccessories": {
        "title": "Discover all accessories",
        "type": "boolean",
        "default": false,
        "required": false
      },
      "global": {
        "type": "object",
        "properties": {
          "pollingInterval": {
            "type": "number",
            "placeholder": "2000"
          },
          "verbose": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "accessories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "required": true,
              "description": "Name of the speaker"
            },
            "ip": {
              "type": "string",
              "required": false,
              "description": "IP address to use to find accessory"
            },
            "room": {
              "type": "string",
              "required": false,
              "description": "Room to use to find accessory if ip is not set"
            },
            "pollingInterval": {
              "type": "integer",
              "default": 2000
            }
          }
        }
      }
    }
  }
}
